# Environment variables the read functions read (`process.env`), with no
# values. Set them on the Vercel project for Production and Preview. The lane
# server (`npm run dev`) needs none of them: it serves the golden snapshots.

# Read-only Storj S3 credential, limited to sj://lookout/snapshot/
STORJ_ACCESS_KEY_ID=
STORJ_SECRET_ACCESS_KEY=
STORJ_ENDPOINT_URL=
STORJ_BUCKET=lookout

# The station's MAC address: the default for /dashboard and /current
# (the same name and value the VPS uses).
STATION_MAC=

# Vercel's own Ambient key (or the VPS key if Ambient allows only one)
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
# Optional; defaults to https://rt.ambientweather.net/v1
AMBIENT_ENDPOINT=
